      "case": "time-order-window",
      "ordinal": 9,
      "runtimeId": "java-runtime-320f1b03eddb24520308",
      "executionName": "InfraTimeOrderWindow",
      "description": "time_order(value, 10 sec) window over the key/value map schema: rows are retained while value >= clock - 9999 and released old-only by timer waves during advance-time, with deletes releasing immediately and ascending-value iterators",
      "createEpl": "@name('create') @public create window MyWindowTOW#time_order(value, 10 sec) as MySimpleKeyValueMap",
      "insertEpl": "insert into MyWindowTOW select theString as key, longBoxed as value from SupportBean",
      "s0Epl": "@name('s0') select irstream key, value as value from MyWindowTOW",
      "consumeEpl": "",
      "deleteEpl": "@name('delete') on SupportMarketDataBean delete from MyWindowTOW where symbol = key",
      "deploys": ["create", "insert", "s0", "delete"],
      "listened": ["create", "s0"],
      "iteratorSnapshots": 4
    },
    {
      "case": "time-order-scene-two",
      "ordinal": 10,
      "runtimeId": "java-runtime-ed5bfc247d088a603224",
      "executionName": "InfraTimeOrderSceneTwo",
      "description": "legacy ext:time_order(value, 10) projection window over theString/longBoxed with three module deployments and only the window statement listened; a stale arriving row passes through in one callback carrying both streams",
      "createEpl": "@name('create') @public create window MyWindow.ext:time_order(value, 10) as select theString as key, longBoxed as value from SupportBean",
      "insertEpl": "insert into MyWindow(key, value) select irstream theString, longBoxed from SupportBean",
      "s0Epl": "",
      "consumeEpl": "",
      "deleteEpl": "@name('delete') on SupportMarketDataBean as s0 delete from MyWindow as s1 where s0.symbol = s1.key",
      "deploys": ["create", "insert", "delete"],
      "listened": ["create"],
      "iteratorSnapshots": 10
    },
    {
      "case": "time-accum",
      "ordinal": 14,
      "runtimeId": "java-runtime-d74b2c9c614b26973637",
      "executionName": "InfraTimeAccum",
      "description": "time_accum(10 sec) window over the key/value map schema: arrivals deliver immediately and re-arm the flush to their arrival plus ten seconds, whose bursts release all retained rows as old data in insertion order, with newest-row deletes re-arming and last-row deletes cancelling the timer",
      "createEpl": "@name('create') create window MyWindowTA#time_accum(10 sec) as MySimpleKeyValueMap",
      "insertEpl": "insert into MyWindowTA select theString as key, longBoxed as value from SupportBean",
      "s0Epl": "@name('s0') select irstream key, value as value from MyWindowTA",
      "consumeEpl": "",
      "deleteEpl": "@name('delete') on SupportMarketDataBean as s0 delete from MyWindowTA as s1 where s0.symbol = s1.key",
      "deploys": ["create", "insert", "s0", "delete"],
      "listened": ["create", "s0"],
      "iteratorSnapshots": 8
    },
