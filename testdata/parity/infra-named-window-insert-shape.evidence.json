    "version": "esper-parity/v1",
    "id": "infra-named-window-insert-shape",
    "steps": [
      {
        "op": "case",
        "case": "double-insert-same-window"
      },
      {
        "op": "deploy",
        "case": "double-insert-same-window",
        "statement": "create",
        "epl": "@name('create') create window MyWindowDISM#keepall as MySimpleKeyValueMap"
      },
      {
        "op": "deploy",
        "case": "double-insert-same-window",
        "statement": "insert-one",
        "epl": "insert into MyWindowDISM select theString as key, longBoxed+1 as value from SupportBean"
      },
      {
        "op": "deploy",
        "case": "double-insert-same-window",
        "statement": "insert-two",
        "epl": "insert into MyWindowDISM select theString as key, longBoxed+2 as value from SupportBean"
      },
      {
        "op": "deploy",
        "case": "double-insert-same-window",
        "statement": "s0",
        "epl": "@name('s0') select key, value as value from MyWindowDISM"
      },
      {
        "op": "send",
        "case": "double-insert-same-window",
        "eventType": "SupportBean",
        "payload": {
          "theString": "E1",
          "longBoxed": 10
        }
      },
      {
        "op": "undeploy-all",
        "case": "double-insert-same-window"
      },
      {
        "op": "case",
        "case": "intersection",
        "mode": "any"
      },
      {
        "op": "deploy",
        "case": "intersection",
        "statement": "create",
        "epl": "create window MyWindowINT#length(2)#unique(intPrimitive) as SupportBean"
      },
      {
        "op": "deploy",
        "case": "intersection",
        "statement": "insert",
        "epl": "insert into MyWindowINT select * from SupportBean"
      },
      {
        "op": "deploy",
        "case": "intersection",
        "statement": "s0",
        "epl": "@name('s0') select irstream * from MyWindowINT"
      },
      {
        "op": "send",
        "case": "intersection",
        "eventType": "SupportBean",
        "payload": {
          "theString": "E1",
          "intPrimitive": 1
        }
      },
      {
        "op": "send",
        "case": "intersection",
        "eventType": "SupportBean",
        "payload": {
          "theString": "E2",
          "intPrimitive": 2
        }
      },
      {
        "op": "send",
        "case": "intersection",
        "eventType": "SupportBean",
        "payload": {
          "theString": "E3",
          "intPrimitive": 2
        }
      },
      {
        "op": "undeploy-all",
        "case": "intersection"
      },
      {
        "op": "case",
        "case": "select-stream-dot-star-insert"
      },
      {
        "op": "deploy",
        "case": "select-stream-dot-star-insert",
        "statement": "create",
        "epl": "@EventRepresentation('objectarray') create window MyNWWindowObjectArray#keepall (p0 int)"
      },
      {
        "op": "deploy",
        "case": "select-stream-dot-star-insert",
        "statement": "insert",
        "epl": "insert into MyNWWindowObjectArray select intPrimitive as p0, sb.* as c0 from SupportBean as sb"
      },
      {
        "op": "undeploy-all",
        "case": "select-stream-dot-star-insert"
      },
      {
        "op": "case",
        "case": "on-insert-preemptive-two-window"
      },
      {
        "op": "deploy",
        "case": "on-insert-preemptive-two-window",
        "statement": "schema",
        "epl": "@public @buseventtype create schema TypeOne(col1 int);\n@public @buseventtype create schema TypeTwo(col2 int);\n@public @buseventtype create schema TypeTrigger(trigger int)"
      },
      {
        "op": "deploy",
        "case": "on-insert-preemptive-two-window",
        "statement": "create",
        "epl": "create window WinOne#keepall as TypeOne;\ncreate window WinTwo#keepall as TypeTwo"
      },
      {
        "op": "deploy",
        "case": "on-insert-preemptive-two-window",
        "statement": "insert",
        "epl": "@name('insert-window-one') insert into WinOne(col1) select intPrimitive from SupportBean"
      },
      {
        "op": "deploy",
        "case": "on-insert-preemptive-two-window",
        "statement": "s2",
        "epl": "@name('insert-otherstream') on TypeTrigger insert into OtherStream select col1 from WinOne"
      },
      {
        "op": "deploy",
        "case": "on-insert-preemptive-two-window",
        "statement": "s3",
        "epl": "@name('insert-window-two') on TypeTrigger insert into WinTwo(col2) select col1 from WinOne"
      },
      {
        "op": "deploy",
        "case": "on-insert-preemptive-two-window",
        "statement": "s0",
        "epl": "@name('s0') on OtherStream select col2 from WinTwo"
      },
      {
        "op": "send",
        "case": "on-insert-preemptive-two-window",
        "eventType": "SupportBean",
        "payload": {
          "theString": "E1",
          "intPrimitive": 9
        }
      },
      {
        "op": "send",
        "case": "on-insert-preemptive-two-window",
        "eventType": "TypeTrigger",
        "payload": {
          "trigger": 0
        }
      },
      {
        "op": "undeploy-all",
        "case": "on-insert-preemptive-two-window"
      }
    ]
  },
