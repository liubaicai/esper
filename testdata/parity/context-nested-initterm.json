   "executionName": "ContextNestedKeySegmentedWInitTermEndEvent",
   "observation": "listener; output all when terminated emits one row {id,c0,c1} where c0/c1 carry the named startevent/endevent events and the terminating intPrimitive=0 event is filtered out of the statement stream"
  }
