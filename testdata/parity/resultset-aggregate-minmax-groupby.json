  ],
  "javaNames": [
    "ResultSetAggregateMinMax",
    "ResultSetAggregateMinNoGroupHaving"
  ],
  "cases": [
    {
      "case": "minmax",
      "ordinal": 0,
      "runtimeId": "java-runtime-6ee286d6f857ddbbd091",
      "executionName": "ResultSetAggregateMinMax",
      "observation": "listener",
      "epl": "@name('s0') select irstream symbol, min(all volume) as minVol, max(all volume) as maxVol, min(distinct volume) as minDistVol, max(distinct volume) as maxDistVol from SupportMarketDataBean#length(3) where symbol='DELL' or symbol='IBM' or symbol='GE' group by symbol"
    },
    {
      "case": "min-no-group-having",
      "ordinal": 4,
      "runtimeId": "java-runtime-cd645170c5defa3996da",
      "executionName": "ResultSetAggregateMinNoGroupHaving",
      "observation": "listener",
      "epl": "@name('s0') select symbol from SupportMarketDataBean#time(5 sec) having volume > min(volume) * 1.3"
    }
  ],
