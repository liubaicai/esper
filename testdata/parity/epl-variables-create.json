  "cases": [
    {
      "case": "variable-om",
      "ordinal": 0,
      "runtimeId": "java-runtime-67e6441b95a4ca30917b",
      "executionName": "EPLVariableOM",
      "observation": "listener; two create-variable deployments (uninitialized long, string initialized to \"abc\") feed a select that observes new=[null,\"abc\"] on the first SupportBean; the SODA toEPL assertions are API-only approved differences",
      "epl": "@name('s0') select var1OMCreate, var2OMCreate from SupportBean"
    },
    {
      "case": "variable-compile-start-stop",
      "ordinal": 1,
      "runtimeId": "java-runtime-74285cbcf0d7aeabf02f",
      "executionName": "EPLVariableCompileStartStop",
      "observation": "listener+variable; select over two module variables, then ESPER-545: an on-pattern set increments module variable FOO to 1, undeploy-all plus redeploy of the create module resets FOO to 0, and a failed compile leaves no residue so the same private create redeploys",
      "epl": "@name('create') @public create variable int FOO = 0"
    },
    {
      "case": "variable-subscribe-iterate",
      "ordinal": 2,
      "runtimeId": "java-runtime-06466d91981a6c410b39",
      "executionName": "EPLVariableSubscribeAndIterate",
      "observation": "listener+variable; create-variable statements deliver committed writes as IR pairs (new=current, old=previous), the on-set assignments apply sequentially so var2SAI sees the new var1SAI, iterator reads track current values, and redeploying create-two resets it to 20 while create-one survives at 400",
      "epl": "@name('set') on SupportBean set var1SAI = intPrimitive * 2, var2SAI = var1SAI + 1"
    },
    {
      "case": "variable-declaration-select",
      "ordinal": 3,
      "runtimeId": "java-runtime-75cb3e01ac92790b5194",
      "executionName": "EPLVariableDeclarationAndSelect",
      "observation": "listener; 29 create-variable modules pin the declaration typing/coercion matrix (string-to-int, expression folding, equality-as-initializer, char/byte/short/float widths, uninitialized nulls) projected by one select",
      "epl": "@name('s0') select varX1,varX2,varX3,varX4,varX5,varX6,varX7,varX8,varX9,varX10,varX11,varX12,varX13,varX14,varX15,varX16,varX17,varX18,varX19,varX20,varX21,varX22,varX23,varX24,varX25,varX26,varX27,varX28,varX29 from SupportBean"
    },
    {
      "case": "variable-dimension-primitive",
      "ordinal": 5,
      "runtimeId": "java-runtime-71775e7db7d1ffd875ba",
      "executionName": "EPLVariableDimensionAndPrimitive",
      "observation": "variable+set-variable-error; runtime set/get over int[primitive], int[], Object[] and Object[][] variables: exact-order reads after writes, and rejections for String[] into int[], int[] into Integer[]/Object[]/Object[][] (primitive arrays are not covariant)",
      "epl": "@name('vars') create variable int[primitive] int_prim = null;\ncreate variable int[] int_boxed = null;\ncreate variable java.lang.Object[] objectarray = null;\ncreate variable java.lang.Object[][] objectarray_2dim = null;\n"
    },
    {
      "case": "variable-generic-type",
      "ordinal": 6,
      "runtimeId": "java-runtime-4ac4b7b111d10a20f74d",
      "executionName": "EPLVariableGenericType",
      "observation": "listener+variable; a List<String> variable initialized to [a,b] reads back in exact order and projects c0=[a,b] plus the enum-where filtered c1=[a] on a SupportBean send",
      "epl": "@name('var') create variable List<String> mylist = Arrays.asList('a', 'b');\n@name('s0') select mylist as c0, mylist.where(v => v = 'a') as c1 from SupportBean;\n"
    }
  ],
