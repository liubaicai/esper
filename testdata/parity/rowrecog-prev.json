 "cases": [
  {
   "case": "timewindow-partitioned-simple",
   "ordinal": 0,
   "runtimeId": "java-runtime-c096e55f89e15fcc54b7",
   "executionName": "RowRecogTimeWindowPartitionedSimple",
   "observation": "listener+iterator; virtual time; prev history survives time-window eviction (E4 matches at 6200 against E1 sent at 1000); time-window expiry shrinks the iterator at 11200/11600/16000",
   "epl": "@name('s0') select * from SupportRecogBean#time(5 sec) match_recognize (  partition by cat   measures A.cat as cat, A.theString as a_string  all matches pattern (A)   define     A as PREV(A.value) = (A.value - 1)) order by a_string"
  },
  {
   "case": "partition-by-2-fields-keepall",
   "ordinal": 1,
   "runtimeId": "java-runtime-9c42dd39d70d409a64d7",
   "executionName": "RowRecogPartitionBy2FieldsKeepall",
   "observation": "listener+iterator; keepall partitioned by theString,cat; the null-cat S1 partition produces no output",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize (  partition by theString, cat  measures A.theString as a_string, A.cat as a_cat, A.value as a_value, B.value as b_value   all matches pattern (A B)   define     A as (A.value > PREV(A.value)),    B as (B.value > PREV(B.value))) order by a_string, a_cat"
  },
  {
   "case": "unpartitioned-keepall",
   "ordinal": 2,
   "runtimeId": "java-runtime-1200bc1d6899155bac4a",
   "executionName": "RowRecogUnpartitionedKeepAll",
   "observation": "listener+iterator; two sequential deployments mirroring undeployModuleContaining plus redeploy: stmt1 defines A.value > PREV(A.value), stmt2 defines PREV(A.value, 2) = 5 (indexed prev)",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize (  measures A.theString as a_string  all matches pattern (A)   define A as (A.value > PREV(A.value))) order by a_string"
  },
  {
   "case": "timewindow-unpartitioned",
   "ordinal": 3,
   "runtimeId": "java-runtime-241336e6d46c14fbcf06",
   "executionName": "RowRecogTimeWindowUnpartitioned",
   "observation": "listener+iterator; virtual time; multi-index prev on string and numeric fields, prev(x,0) under Math.abs, IN over prev; iterator expiry at 9500/11500",
   "epl": "@name('s0') select * from SupportRecogBean#time(5) match_recognize (  measures A.theString as a_string, B.theString as b_string  all matches pattern (A B)   define     A as PREV(A.theString, 3) = 'P3' and PREV(A.theString, 2) = 'P2' and PREV(A.theString, 4) = 'P4' and Math.abs(prev(A.value, 0)) >= 0,    B as B.value in (PREV(B.value, 4), PREV(B.value, 2)))"
  },
  {
   "case": "timewindow-partitioned",
   "ordinal": 4,
   "runtimeId": "java-runtime-59f7afa17be17f57fbd5",
   "executionName": "RowRecogTimeWindowPartitioned",
   "observation": "listener+iterator; virtual time; the timewindow-unpartitioned shape partitioned by cat with per-partition prev history and per-partition time expiry",
   "epl": "@name('s0') select * from SupportRecogBean#time(5) match_recognize (  partition by cat  measures A.cat as cat, A.theString as a_string, B.theString as b_string  all matches pattern (A B)   define     A as PREV(A.theString, 3) = 'P3' and PREV(A.theString, 2) = 'P2' and PREV(A.theString, 4) = 'P4',    B as B.value in (PREV(B.value, 4), PREV(B.value, 2))) order by cat"
  },
  {
   "case": "example-with-prev",
   "ordinal": 5,
   "runtimeId": "java-runtime-41c5b0a59540aec34895",
   "executionName": "RowRecogExampleWithPREV",
   "observation": "listener; keepall with 20 measure columns and after match skip to current row over ( A B C* D E* F+ ); A is undefined (matches any row); E7 produces 1 row, E8 3 rows, E9 5 rows",
   "epl": "@name('s0') SELECT * FROM SupportRecogBean#keepall   MATCH_RECOGNIZE (       MEASURES A.theString AS a_string,         A.value AS a_value,         B.theString AS b_string,         B.value AS b_value,         C[0].theString AS c0_string,         C[0].value AS c0_value,         C[1].theString AS c1_string,         C[1].value AS c1_value,         C[2].theString AS c2_string,         C[2].value AS c2_value,         D.theString AS d_string,         D.value AS d_value,         E[0].theString AS e0_string,         E[0].value AS e0_value,         E[1].theString AS e1_string,         E[1].value AS e1_value,         F[0].theString AS f0_string,         F[0].value AS f0_value,         F[1].theString AS f1_string,         F[1].value AS f1_value       ALL MATCHES       after match skip to current row       PATTERN ( A B C* D E* F+ )       DEFINE /* A is unspecified, defaults to TRUE, matches any row */            B AS (B.value < PREV (B.value)),            C AS (C.value <= PREV (C.value)),            D AS (D.value < PREV (D.value)),            E AS (E.value >= PREV (E.value)),            F AS (F.value >= PREV (F.value) and F.value > A.value))"
  }
 ],
