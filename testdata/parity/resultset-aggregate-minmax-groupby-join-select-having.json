  "cases": [
    {
      "case": "minmax-join",
      "ordinal": 3,
      "runtimeId": "java-runtime-802aec9425dc772e3aa5",
      "executionName": "ResultSetAggregateMinMaxJoin",
      "observation": "listener",
      "epl": "@name('s0') select irstream symbol, min(volume) as minVol, max(volume) as maxVol, min(distinct volume) as minDistVol, max(distinct volume) as maxDistVol from SupportBeanString#length(100) as one, SupportMarketDataBean#length(3) as two where (symbol='DELL' or symbol='IBM' or symbol='GE') and one.theString = two.symbol group by symbol"
    },
    {
      "case": "min-no-group-select-having",
      "ordinal": 5,
