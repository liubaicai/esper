      "executionName": "ResultSetAggregateMinNoGroupSelectHaving",
      "observation": "listener",
      "epl": "@name('s0') select symbol, min(volume) as mymin from SupportMarketDataBean#length(5) having volume > min(volume) * 1.3"
    }
  ],
