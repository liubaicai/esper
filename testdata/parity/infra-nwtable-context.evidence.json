        "statement": "ctx",
        "epl": "@public create context ContextOne start SupportBean_S0 end SupportBean_S1"
      },
      {
        "op": "deploy",
        "case": "named-window",
        "statement": "create",
        "epl": "@public context ContextOne create window MyInfra#keepall as (pkey0 string, pkey1 int, c0 long)"
      },
      {
        "op": "deploy",
        "case": "named-window",
        "statement": "insert",
        "epl": "context ContextOne insert into MyInfra select theString as pkey0, intPrimitive as pkey1, longPrimitive as c0 from SupportBean"
      },
      {
        "op": "send",
        "case": "named-window",
        "eventType": "SupportBean_S0",
        "payload": {
          "id": 0
        }
      },
