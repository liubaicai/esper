          "longPrimitive": 200
        }
      },
      {
        "op": "deploy",
        "case": "named-window",
        "statement": "s1",
        "epl": "@name('s1')context ContextOne select * from MyInfra output snapshot when terminated"
      },
      {
        "op": "deploy",
        "case": "named-window",
        "statement": "s2",
        "epl": "@name('s2')context ContextOne select count(*) as thecnt from MyInfra output snapshot when terminated"
      },
      {
        "op": "deploy",
        "case": "named-window",
        "statement": "s3",
