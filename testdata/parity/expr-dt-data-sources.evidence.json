        "op": "case",
        "case": "start-end-ts"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "schema-map",
        "epl": "@buseventtype @public create schema ParentType as (startTS long, endTS long) starttimestamp startTS endtimestamp endTS;\n@buseventtype @public create schema ChildType as (foo string) inherits ParentType;\n"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "select-map",
        "epl": "@name('s0') select * from ChildType dt where dt.before(current_timestamp())"
      },
      {
        "op": "types",
        "case": "start-end-ts",
        "statement": "select-map"
      },
      {
        "op": "undeploy-all",
        "case": "start-end-ts"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "schema-objectarray",
        "epl": "@buseventtype @public create objectarray schema ParentType as (startTS long, endTS long) starttimestamp startTS endtimestamp endTS;\n@buseventtype @public create objectarray schema ChildType as (foo string) inherits ParentType;\n"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "select-objectarray",
        "epl": "@name('s0') select * from ChildType dt where dt.before(current_timestamp())"
      },
      {
        "op": "types",
        "case": "start-end-ts",
        "statement": "select-objectarray"
      },
      {
        "op": "undeploy-all",
        "case": "start-end-ts"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "schema-pojo",
        "epl": "@public @buseventtype create schema InterfaceType as com.espertech.esper.regressionlib.support.bean.SupportStartTSEndTSInterface starttimestamp startTS endtimestamp endTS;\n@public @buseventtype create schema DerivedType as com.espertech.esper.regressionlib.support.bean.SupportStartTSEndTSImpl inherits InterfaceType"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "select-pojo",
        "epl": "@name('s2') select * from DerivedType dt where dt.before(current_timestamp())"
      },
      {
        "op": "unrepresentable",
        "case": "start-end-ts",
        "statement": "pojo-inheritance",
        "expectError": "POJO create-schema inheritance: create schema InterfaceType as \u003cinterface\u003e starttimestamp startTS endtimestamp endTS with DerivedType inherits InterfaceType compiles and declares startTS/endTS; the typed Go surface has no class-reference schema boundary"
      },
      {
        "op": "undeploy-all",
        "case": "start-end-ts"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "schema-xml",
        "epl": "@XMLSchema(rootElementName='root', schemaText='') @XMLSchemaField(name='startTS', xpath='/abc', type='string', castToType='long')@XMLSchemaField(name='endTS', xpath='/def', type='string', castToType='long')@public @buseventtype create xml schema MyXMLEvent() starttimestamp startTS endtimestamp endTS;\n"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "select-xml",
        "epl": "@name('s2') select * from MyXMLEvent dt where dt.before(current_timestamp())"
      },
      {
        "op": "unrepresentable",
        "case": "start-end-ts",
        "statement": "xml-inheritance",
        "expectError": "XML create-schema: @XMLSchemaField string xpath properties with castToType='long' accepted as starttimestamp/endtimestamp on create xml schema; the Go XML schema surface has no xpath-cast timestamp boundary"
      },
      {
        "op": "undeploy-all",
        "case": "start-end-ts"
      },
      {
        "op": "deploy",
        "case": "start-end-ts",
        "statement": "schema-incompatible",
        "epl": "@public @buseventtype create schema T1 as (startTS long, endTS long) starttimestamp startTS endtimestamp endTS;\n@public @buseventtype create schema T2 as (startTSOne long, endTSOne long) starttimestamp startTSOne endtimestamp endTSOne;\n"
      },
      {
        "op": "build-error",
        "case": "start-end-ts",
        "statement": "inherits-conflict-start",
        "expectError": "Event type declares start timestamp as property 'startTS' however inherited event type 'T2' declares start timestamp as property 'startTSOne'",
        "epl": "create schema T12 as () inherits T1,T2"
      },
      {
        "op": "build-error",
        "case": "start-end-ts",
        "statement": "inherits-conflict-end",
        "expectError": "Event type declares end timestamp as property 'endTSXXX' however inherited event type 'T2' declares end timestamp as property 'endTSOne'",
        "epl": "create schema T12 as (startTSOne long, endTSXXX long) inherits T2 starttimestamp startTSOne endtimestamp endTSXXX"
      },
      {
        "op": "build-error",
        "case": "start-end-ts",
        "statement": "null-start-ts-type",
        "expectError": "Declared start timestamp property 'startTSOne' is expected to return a Date, Calendar or long-typed value but returns 'null'",
        "epl": "create schema T12 as (startTSOne null, endTSXXX long) starttimestamp startTSOne endtimestamp endTSXXX"
      },
      {
        "op": "undeploy-all",
        "case": "start-end-ts"
      }
    ]
  },
