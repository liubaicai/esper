      "ordinal": 44,
      "runtimeId": "java-runtime-3326973240f20b92dced",
      "executionName": "InfraSelectGroupedViewLateStart",
      "description": "grouped #groupwin(theString, intPrimitive)#length(9) projection window whose count(*) consumer is deployed after the window is populated: the late preload builds the per-group counts, the window iterator keeps the twelve rows of the ten groups, and the consumer iterates one sorted row per group",
      "createEpl": "@name('create') @public create window MyWindowSGVS#groupwin(theString, intPrimitive)#length(9) as select theString, intPrimitive from SupportBean",
      "insertEpl": "@name('insert') insert into MyWindowSGVS select theString, intPrimitive from SupportBean",
      "s0Epl": "@name('s0') select theString, intPrimitive, count(*) from MyWindowSGVS group by theString, intPrimitive order by theString, intPrimitive",
      "consumeEpl": "",
      "deleteEpl": "",
      "varEpl": "",
      "onSetEpl": "",
      "deploys": ["create", "insert", "s0"],
      "listened": [],
