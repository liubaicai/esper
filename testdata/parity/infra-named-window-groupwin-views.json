    {
      "case": "select-grouped-view-late-start-variable-iterate",
      "ordinal": 55,
      "runtimeId": "java-runtime-0ec49d4098c9796540b0",
      "executionName": "InfraSelectGroupedViewLateStartVariableIterate",
      "description": "grouped #groupwin(theString, intPrimitive)#length(9) projection window whose variable-filtered avg/count consumer is deployed after the window is populated: the late preload builds the group state including both rows of the non-uniform (c1,1) group, and the having clause reads the runtime variable at iterate time so the on-set trigger switches the visible theString group",
      "createEpl": "@name('create') @public create window MyWindowSGVLS#groupwin(theString, intPrimitive)#length(9) as select theString, intPrimitive, longPrimitive, boolPrimitive from SupportBean",
      "insertEpl": "insert into MyWindowSGVLS select theString, intPrimitive, longPrimitive, boolPrimitive from SupportBean",
      "s0Epl": "@name('s0') select theString, intPrimitive, avg(longPrimitive) as avgLong, count(boolPrimitive) as cntBool from MyWindowSGVLS group by theString, intPrimitive having theString = var_1_1_1 order by theString, intPrimitive",
      "consumeEpl": "",
      "deleteEpl": "",
      "varEpl": "@public create variable string var_1_1_1",
      "onSetEpl": "on SupportVariableSetEvent(variableName='var_1_1_1') set var_1_1_1 = value",
      "deploys": ["create", "insert", "var", "on-set", "s0"],
      "listened": [],
