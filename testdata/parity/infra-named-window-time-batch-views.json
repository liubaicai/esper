      "runtimeId": "java-runtime-1ad42a8ed8025c4a0730",
      "executionName": "InfraTimeBatch",
      "description": "time_batch(10 sec) window over the key/value map schema: arrivals buffer silently, deletes remove pending rows without a callback, and boundary flushes deliver the buffered rows as one new-data batch followed by an old-only flush of the previous batch",
      "createEpl": "@name('create') create window MyWindowTB#time_batch(10 sec) as MySimpleKeyValueMap",
      "insertEpl": "insert into MyWindowTB select theString as key, longBoxed as value from SupportBean",
      "s0Epl": "@name('s0') select key, value as value from MyWindowTB",
      "consumeEpl": "",
      "deleteEpl": "@name('delete') on SupportMarketDataBean as s0 delete from MyWindowTB as s1 where s0.symbol = s1.key",
      "deploys": ["create", "insert", "s0", "delete"],
      "listened": ["create", "s0"],
      "iteratorSnapshots": 5
    },
    {
