      "executionName": "InfraFilteringConsumer",
      "description": "unique(key) window over the theString/intPrimitive projection: a same-key arrival replaces the stored row in one callback carrying the new and the replaced row, and the filtered consumer evaluates its filter on both streams so the replaced row still passes while the filtered-out new row is dropped",
      "createEpl": "@name('create') create window MyWindowFC#unique(key) as select theString as key, intPrimitive as value from SupportBean",
      "insertEpl": "insert into MyWindowFC select theString as key, intPrimitive as value from SupportBean",
      "s0Epl": "@name('s0') select irstream key, value as value from MyWindowFC(value > 0, value < 10)",
      "s2Epl": "",
      "s3Epl": "",
      "consumeEpl": "",
      "deleteEpl": "@name('delete') on SupportMarketDataBean as s0 delete from MyWindowFC as s1 where s0.symbol = s1.key",
