 "cases": [
  {
   "case": "interval-simple",
   "ordinal": 0,
   "runtimeId": "java-runtime-02e57a7f151323edc4be",
   "executionName": "RowRecogIntervalSimple",
   "observation": "listener+iterator; two deploy cycles mirroring compileDeploy plus eplToModelCompileDeploy; completed matches emit at the inclusive 10-second interval boundary anchored to the match-begin event (11000/23000/35000); the iterator sees scheduled-but-unemitted matches at 10999",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, last(B.theString) as lastb pattern (A B*) interval 10 seconds define A as A.theString like \"A%\", B as B.theString like \"B%\") order by a, b0, b1, lastb"
  },
  {
   "case": "interval-partitioned",
   "ordinal": 1,
   "runtimeId": "java-runtime-b9a2b0afe61a2bfabcd0",
   "executionName": "RowRecogPartitioned",
   "observation": "listener+iterator; partition by cat; per-partition interval emission at 11000 (cat C1 and C2), 12000 (C3) and 13000 (C4)",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize (  partition by cat   measures A.theString as a, B[0].theString as b0, B[1].theString as b1, last(B.theString) as lastb  pattern (A B*)   INTERVAL 10 seconds   define     A as A.theString like 'A%',    B as B.theString like 'B%') order by a, b0, b1, lastb"
  },
  {
   "case": "interval-multicompleted",
   "ordinal": 2,
   "runtimeId": "java-runtime-1361f7530aa059720913",
   "executionName": "RowRecogMultiCompleted",
   "observation": "listener+iterator; multiple completed matches drain across successive interval boundaries at 11000, 15000, 31000 and 32000",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize (  measures A.theString as a, B[0].theString as b0, B[1].theString as b1, last(B.theString) as lastb  pattern (A B*)   interval 10 seconds   define     A as A.theString like 'A%',    B as B.theString like 'B%') order by a, b0, b1, lastb"
  },
  {
   "case": "interval-monthscoped",
   "ordinal": 3,
   "runtimeId": "java-runtime-373cb011a639d99148f0",
   "executionName": "RowRecogMonthScoped",
   "observation": "listener; SupportBean without a keepall window; calendar month interval emits at 2002-03-01T09:00:00.000Z but not one millisecond earlier",
   "epl": "@name('s0') select * from SupportBean match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1  pattern (A B*) interval 1 month define A as A.theString like \"A%\", B as B.theString like \"B%\")"
  },
  {
   "case": "orterminated-doc-sample",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; TemperatureSensorEvent object-array partitioned by device; the E5 send at temp 100 terminates the match emitting {E2,2,E3,E4}; the interval timer at MAX_VALUE emits nothing further",
   "epl": "@name('s0') select * from TemperatureSensorEvent\nmatch_recognize (\n  partition by device\n  measures A.id as a_id, count(B.id) as count_b, first(B.id) as first_b, last(B.id) as last_b\n  pattern (A B*)\n  interval 5 seconds or terminated\n  define\n    A as A.temp > 100,\n    B as B.temp > 100)"
  },
  {
   "case": "orterminated-a-b",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A B) emits immediately on B so the interval is not effective; the A2 strand dies on the A3 misfit",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B.theString as b pattern (A B) interval 10 seconds or terminated define A as A.theString like 'A%', B as B.theString like 'B%')"
  },
  {
   "case": "orterminated-a-bstar",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; misfit X1 terminates the A1 match emitting {A1,B1,null,null}; timer expiry at 30000 emits {A2,B2,null,null}",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, B[2].theString as b2 pattern (A B*) interval 10 seconds or terminated define A as A.theString like \"A%\", B as B.theString like \"B%\")"
  },
  {
   "case": "orterminated-a-bstar-allmatches",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; all-matches variant emits both the A-only and A,B end states per match, asserted any-order in Java",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, B[2].theString as b2 all matches pattern (A B*) interval 10 seconds or terminated define A as A.theString like \"A%\", B as B.theString like \"B%\")"
  },
  {
   "case": "orterminated-a-bstar-or-c",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A (B* | C)); C1 terminates A1 emitting the C branch; X1 terminates A2 emitting {A2,B1,B2,null,null}; A3 emits at the 10000 boundary",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, B[2].theString as b2, C.theString as c  pattern (A (B* | C)) interval 10 seconds or terminated define A as A.theString like 'A%', B as B.theString like 'B%', C as C.theString like 'C%')"
  },
  {
   "case": "orterminated-a-bstar-or-cstar",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A (B* | C*)); X1 terminates A1 immediately; the B1 misfit terminates the C branch emitting {A2,null,null,C1,null}",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, C[0].theString as c0, C[1].theString as c1  pattern (A (B* | C*)) interval 10 seconds or terminated define A as A.theString like 'A%', B as B.theString like 'B%', C as C.theString like 'C%')"
  },
  {
   "case": "orterminated-a-b-cstar",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A B C*); the B2 misfit emits {A1,B1,C1,C2,null}; X3 emits {A3,B4,null,null,null}; the A4 match emits at the 30000 boundary",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B.theString as b, C[0].theString as c0, C[1].theString as c1, C[2].theString as c2  pattern (A B C*) interval 10 seconds or terminated define A as A.theString like 'A%', B as B.theString like 'B%', C as C.theString like 'C%')"
  },
  {
   "case": "orterminated-a-bplus",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A B+); X2 emits {A2,B2,null,null}; X3 emits {A4,B3,B4,null}",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, B[2].theString as b2 pattern (A B+) interval 10 seconds or terminated define A as A.theString like 'A%', B as B.theString like 'B%')"
  },
  {
   "case": "orterminated-astar",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A*); the B1 misfit emits {A1,A2,null,null,null}; interval expiry at 12000 emits {A3,A4,A5,null,null}; B2 emits {A3,A4,A5,A6,null}",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A[0].theString as a0, A[1].theString as a1, A[2].theString as a2, A[3].theString as a3, A[4].theString as a4 pattern (A*) interval 10 seconds or terminated define A as theString like 'A%')"
  },
  {
   "case": "orterminated-a-parens-bstar",
   "ordinal": 0,
   "runtimeId": "java-runtime-bd18c2cfd8ff34a0b5a3",
   "executionName": "RowRecogIntervalOrTerminated",
   "observation": "listener; pattern (A (B)*) mirrors a-bstar with a parenthesized repeat; X1 emits {A1,B1,null,null}; timer expiry at 30000 emits {A2,B2,null,null}",
   "epl": "@name('s0') select * from SupportRecogBean#keepall match_recognize ( measures A.theString as a, B[0].theString as b0, B[1].theString as b1, B[2].theString as b2 pattern (A (B)*) interval 10 seconds or terminated define A as A.theString like \"A%\", B as B.theString like \"B%\")"
  }
 ],
